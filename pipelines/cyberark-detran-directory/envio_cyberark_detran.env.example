# envio_cyberark_detran.env
# Credenciais e parametros do pipeline cyberark-detran-directory
# (fonte: CyberArk tenant Detran — join User <-> Role feito no worker,
# indexado numa unica data stream).
# Em producao: copiar para /etc/logstash/envio_cyberark_detran.env,
# chmod 600, dono logstash:logstash.
#
# NOTA: credenciais aqui em texto puro (mesmo padrao ja usado no resto da
# plataforma, ver CLAUDE.md secao 11 - pendencia de rotacao).
#
# DETRAN_CLIENT_ID / DETRAN_CLIENT_SECRET / DETRAN_TOKEN_URL: MESMO tenant e
# credenciais ja usados pelo pipeline usersselo-snapshot (tenant abb4724,
# endpoint /OAuth2/Token/PainelDetran, client_id user_bi_elastic — ver
# CLAUDE.md secao 8, linha "users/Selo"). Este pipeline novo faz um join
# User x Role nesse MESMO tenant/API (que ja recebe carga do dump 2x/dia
# do usersselo). Fornecido pelo usuario em 2026-09-08.
#
# INCIDENTE (2026-08-24, ver topo do worker e DEPLOY.md): a tabela
# RoleMember nao e consultavel em bulk via /Redrock/query nesse tenant
# (trava, mesmo sem JOIN). Roles agora vem via endpoint dedicado
# /Roles/GetRoleMembers, chamado uma vez por role (DETRAN_ROLE_MEMBERS_URL).

# --- Elastic (destino) ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=rafael.silva@asper.tec.br
ELASTIC_PASSWORD=Casa@@4321
DETRAN_DATA_STREAM=logs-cyberark.detrandirectory-default

# --- CyberArk tenant Detran (origem) ---
DETRAN_TOKEN_URL=https://abb4724.id.cyberark.cloud/OAuth2/Token/PainelDetran
DETRAN_QUERY_URL=https://abb4724.id.cyberark.cloud/Redrock/query
DETRAN_ROLE_MEMBERS_URL=https://abb4724.id.cyberark.cloud/Roles/GetRoleMembers
DETRAN_CLIENT_ID=user_bi_elastic
DETRAN_CLIENT_SECRET='UZ}RnDfi|8#b]hvoh69uSh4[pa[NG/-9|oKL>\XS'

# --- Paginacao / paralelismo ---
# Users: volume BEM menor que o Prodesp -- probe 2026-09-08 mediu 19.338
# usuarios no total (FullCount), dump completo com PageSize=50000 (cabe
# numa pagina so) levou ~4,4s.
DETRAN_USERS_PAGE_SIZE=50000
# Roles: paginacao DENTRO de uma role (GetRoleMembers), nao por username.
DETRAN_ROLES_PAGE_SIZE=2000
# quantas roles buscar em paralelo (57 roles no total, medido por probe)
DETRAN_ROLES_MAX_WORKERS=5
# use >0 pra limitar quantas roles processar no smoke test (0 = todas)
DETRAN_ROLES_MAX_COUNT=0
# Teto duro herdado do incidente equivalente no tenant Prodesp (role
# paginando sem nunca esvaziar, travava fetch_all_roles inteiro em
# silencio). Nao observado no probe do tenant Detran (2026-09-08: todas as
# 57 roles responderam numa pagina so, hasMoreRows=false mesmo com
# PageSize=5000) -- mantido como protecao contra anomalia futura, nao deve
# ser atingido numa role normal deste tenant:
DETRAN_ROLES_MAX_PAGES_PER_ROLE=20
# timeout por chamada ao GetRoleMembers -- probe manual 2026-09-08 (tenant
# Detran, abb4724): maioria das 57 roles e pequena/rapida (<10 membros,
# <1s), mas "Adesao - eCRV" (6230 membros, ~14s isolada) e "Adesao - eCNH"
# (13329 membros, ~26s isolada) estouraram um timeout de 25s quando
# concorrendo com as outras DETRAN_ROLES_MAX_WORKERS=5 threads. Nao e
# paginacao infinita, e so volume real. 45s da margem sobre os ~26s
# observados isolado.
DETRAN_ROLE_MEMBERS_TIMEOUT_SECONDS=45
# use >0 pra limitar paginas no smoke test do dump de users (0 = sem limite)
DETRAN_USERS_MAX_PAGES=0

# --- Retry ---
DETRAN_MAX_RETRIES=3
DETRAN_RETRY_BACKOFF_SECONDS=5

# --- Agendamento (cron do input exec `schedule`) ---
# 20:00 e 23:00 horario de Brasilia (lista no campo hora do cron, sintaxe
# padrao). CONFIRMADO POR COMANDO (timedatectl, 2026-08-24) que o servidor
# roda com TZ=America/Sao_Paulo, entao o cron ja e interpretado em hora
# local -- SEM conversao pra UTC.
#
# Por que 2 execucoes por noite, nao 1 (padrao herdado do pipeline irmao
# cyberark-prodesp-directory): no Prodesp, um .env em producao ficou com
# a var de schedule corrompida por uma edicao malfeita e o pipeline nunca
# disparou -- zero dado subiu por dias, em silencio, sem ninguem perceber
# (isso NUNCA aconteceu com este arquivo/tenant Detran, e so o motivo do
# padrao 2x/noite ter virado convencao da plataforma). O requisito real do
# cliente e "dado pronto e correto toda manha", nao ingestao continua --
# rodar 2x na mesma noite (20h + 23h) e a rede de seguranca barata pra
# isso: se a 1a falhar (rede, auth, .env errado), a 2a ainda cobre a manha
# seguinte. Custo aqui e baixo (~90s por execucao, medido por probe neste
# tenant -- bem diferente do Prodesp): rodar mais vezes por dia tambem e
# viavel, se o cliente quiser dado mais fresco.
# _id continua chaveado por snapshot_date (dia) -- a 2a rodada regenera
# os mesmos _id de quem nao mudou (409 benigno), so acrescenta o que
# mudou entre as duas. Ver DEPLOY.md para o diagnostico completo.
#
# SEMPRE conferir com "grep DETRAN_SCHEDULE" apos editar este arquivo em
# producao -- foi o tipo de edicao silenciosamente quebrada que causou o
# incidente no Prodesp.
DETRAN_SCHEDULE="0 20,23 * * *"

# --- Bootstrap (ILM + template), opcional ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# DETRAN_ILM_HOT_MAX_AGE=7d
# DETRAN_ILM_HOT_MAX_SHARD_SIZE=50gb
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=CyberArk Detran - Users x Roles
