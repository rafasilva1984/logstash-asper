# envio_cyberark_prodesp.env
# Credenciais e parametros do pipeline cyberark-prodesp-directory
# (fonte: CyberArk tenant Prodesp — join User <-> Role feito no worker,
# indexado numa unica data stream).
# Em producao: copiar para /etc/logstash/envio_cyberark_prodesp.env,
# chmod 600, dono logstash:logstash.
#
# NOTA: credenciais aqui em texto puro (mesmo padrao ja usado no resto da
# plataforma, ver CLAUDE.md secao 11 - pendencia de rotacao).
#
# PRODESP_CLIENT_ID / PRODESP_CLIENT_SECRET: reaproveitadas do tenant
# Prodesp ja usado pelo pipeline loginprodesp (mesmo endpoint de token —
# CLAUDE.md secao 8, "login Prodesp"). Confirmado com o cliente.
#
# INCIDENTE (2026-08-24, ver topo do worker e DEPLOY.md): a tabela
# RoleMember nao e consultavel em bulk via /Redrock/query nesse tenant
# (trava, mesmo sem JOIN). Roles agora vem via endpoint dedicado
# /Roles/GetRoleMembers, chamado uma vez por role (PRODESP_ROLE_MEMBERS_URL).

# --- Elastic (destino) ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=rafael.silva@asper.tec.br
ELASTIC_PASSWORD=Casa@@4321
PRODESP_DATA_STREAM=logs-cyberark.prodespdirectory-default

# --- CyberArk tenant Prodesp (origem) ---
PRODESP_TOKEN_URL=https://prodesp.id.cyberark.cloud/OAuth2/Token/PainelProdesp
PRODESP_QUERY_URL=https://prodesp.id.cyberark.cloud/Redrock/query
PRODESP_ROLE_MEMBERS_URL=https://prodesp.id.cyberark.cloud/Roles/GetRoleMembers
PRODESP_CLIENT_ID=elastic_bi_asper
PRODESP_CLIENT_SECRET=pya_.=ioq9i<}CgUJcb^4V~I}j8L/jxd9hsM]vW7

# --- Paginacao / paralelismo ---
# Users: custo por linha real nesse backend (~15s fixo + ~0.8ms/linha,
# medido por probe) -> PageSize grande amortiza o fixo. Com PageSize
# 50000 e ~1.25M usuarios, dump completo fica em ~20-25 min.
PRODESP_USERS_PAGE_SIZE=50000
# Roles: paginacao DENTRO de uma role (GetRoleMembers), nao por username.
PRODESP_ROLES_PAGE_SIZE=2000
# quantas roles buscar em paralelo (211 roles no total, medido por probe)
PRODESP_ROLES_MAX_WORKERS=5
# use >0 pra limitar quantas roles processar no smoke test (0 = todas)
PRODESP_ROLES_MAX_COUNT=0
# use >0 pra limitar paginas no smoke test do dump de users (0 = sem limite)
PRODESP_USERS_MAX_PAGES=0

# --- Retry ---
PRODESP_MAX_RETRIES=3
PRODESP_RETRY_BACKOFF_SECONDS=5

# --- Agendamento (cron do input exec `schedule`) ---
# 20:00 e 23:00 horario de Brasilia (lista no campo hora do cron, sintaxe
# padrao). CONFIRMADO POR COMANDO (timedatectl, 2026-08-24) que o servidor
# roda com TZ=America/Sao_Paulo, entao o cron ja e interpretado em hora
# local -- SEM conversao pra UTC.
#
# Por que 2 execucoes por noite, nao 1: incidente 2026-08-24/25, este
# arquivo ja em producao ficou com PRODESP_SCHEDULE corrompido
# ("45 0 * * */'", provavelmente sobra de uma edicao malfeita durante um
# teste manual) e o pipeline nunca disparou -- zero dado subiu por dias,
# em silencio, sem ninguem perceber. O requisito real do cliente e "dado
# pronto e correto toda manha", nao ingestao continua -- rodar 2x na
# mesma noite (20h + 23h) e a rede de seguranca barata pra isso: se a 1a
# falhar (rede, auth, .env errado como aconteceu aqui), a 2a ainda cobre
# a manha seguinte. Custo: mais um dump completo (~20-25min) por noite,
# nada perto de "continuo", e o backend ja aguenta 1x numa execucao soh.
# _id continua chaveado por snapshot_date (dia) -- a 2a rodada regenera
# os mesmos _id de quem nao mudou (409 benigno), so acrescenta o que
# mudou entre as duas. Ver DEPLOY.md para o diagnostico completo.
#
# SEMPRE conferir com "grep PRODESP_SCHEDULE" apos editar este arquivo em
# producao -- foi exatamente uma edicao silenciosamente quebrada aqui que
# causou o incidente.
PRODESP_SCHEDULE="0 20,23 * * *"

# --- Bootstrap (ILM + template), opcional ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# PRODESP_ILM_HOT_MAX_AGE=7d
# PRODESP_ILM_HOT_MAX_SHARD_SIZE=50gb
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=CyberArk Prodesp - Users x Roles
