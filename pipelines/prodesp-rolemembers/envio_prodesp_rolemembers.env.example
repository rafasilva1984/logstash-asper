# envio_prodesp_rolemembers.env
# Credenciais e parametros do pipeline prodesp-rolemembers-daily
# (fonte: CyberArk tenant Prodesp — membros por role via relatorio mfa.js).
# Em producao: copiar para /etc/logstash/envio_prodesp_rolemembers.env,
# chmod 600, dono logstash:logstash. Preencher os <...> no servidor —
# NUNCA commitar o .env real.
#
# Todas as vars tem prefixo PRODESP_ROLEMEMBERS_: os .env de todos os
# pipelines entram no MESMO processo do Logstash (EnvironmentFile da unit),
# e PRODESP_* ja e usado pelo cyberark-prodesp-directory/loginprodesp.

# --- Elastic (destino) — mesmos valores dos outros .env ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=<usuario elastic>
ELASTIC_PASSWORD=<senha elastic>
PRODESP_ROLEMEMBERS_DATA_STREAM=logs-cyberark.prodesprolemembers-default

# --- CyberArk tenant Prodesp (origem) ---
# Mesma credencial do loginprodesp / prodesp-applaunch (client elastic_bi_asper).
PRODESP_ROLEMEMBERS_TOKEN_URL=https://prodesp.id.cyberark.cloud/OAuth2/Token/PainelProdesp
PRODESP_ROLEMEMBERS_QUERY_URL=https://prodesp.id.cyberark.cloud/Redrock/query
PRODESP_ROLEMEMBERS_CLIENT_ID=<client id>
# Entre aspas simples: o secret tem caracteres especiais (vale pro systemd e pro `source`).
PRODESP_ROLEMEMBERS_CLIENT_SECRET='<client secret>'

# --- Agendamento (hora LOCAL do servidor, America/Sao_Paulo — NAO e UTC) ---
# 1x/dia as 03:00. Entre aspas (tem espaco). SEMPRE conferir com grep depois de editar.
PRODESP_ROLEMEMBERS_SCHEDULE="0 3 * * *"

# --- Vias de coleta (probe 2026-10-26/27) ---
# via mfa = relatorio do cliente (traz colunas de MFA). O servidor CORTA em ~300s
# (HTTP 500 "Idaptive") e o custo nao depende do PageSize: role grande nunca sai
# por aqui. Por isso poucas tentativas e, falhou, cai pra via rm na hora.
PRODESP_ROLEMEMBERS_REPORT_SCRIPT=@/lib/reports/compliance/mfa.js
PRODESP_ROLEMEMBERS_MFA_PAGE_SIZE=5000
PRODESP_ROLEMEMBERS_MFA_TIMEOUT_SECONDS=330
PRODESP_ROLEMEMBERS_MFA_MAX_ATTEMPTS=2
# via rm = RoleMember filtrada pela role, paginada (SEDUC - Tutoria 190.688 em ~1,5 min)
PRODESP_ROLEMEMBERS_RM_PAGE_SIZE=10000
# timeout das queries SQL (via rm, catalogo); o servidor corta em ~300s de qualquer jeito
PRODESP_ROLEMEMBERS_TIMEOUT_SECONDS=330
# Nenhuma role e pulada. Everybody so nao conta no role_count/has_role do doc user.
PRODESP_ROLEMEMBERS_IMPLICIT_ROLES="Everybody"

# --- Paralelismo: leves x4, pesadas x1 (pesada = FullCount>=2000, chamada
# >=60s ou ja falhou, pelo historico em role_stats.json; pesada vai direto pela via rm) ---
PRODESP_ROLEMEMBERS_LIGHT_WORKERS=4
PRODESP_ROLEMEMBERS_HEAVY_WORKERS=1
PRODESP_ROLEMEMBERS_HEAVY_MIN_COUNT=2000
PRODESP_ROLEMEMBERS_HEAVY_MIN_SECONDS=60

# --- Retry / passadas: a role so fecha com coletado == FullCount ---
PRODESP_ROLEMEMBERS_MAX_RETRIES=5
PRODESP_ROLEMEMBERS_RETRY_BACKOFF_SECONDS=15
PRODESP_ROLEMEMBERS_RETRY_BACKOFF_MAX_SECONDS=300
PRODESP_ROLEMEMBERS_MAX_PASSES=10
PRODESP_ROLEMEMBERS_PASS_BACKOFF_SECONDS=60
# Cada execucao para de buscar aqui e emite o que tem; a proxima do dia
# continua do checkpoint. 1380 min = 23h: termina antes do disparo das 03:00 seguinte.
PRODESP_ROLEMEMBERS_MAX_RUNTIME_MINUTES=1380

# --- Dump da tabela User (inclui quem nao tem role; resolve o Username da via rm) ---
PRODESP_ROLEMEMBERS_USERS_PAGE_SIZE=50000
PRODESP_ROLEMEMBERS_USERS_TIMEOUT_SECONDS=600

# --- Checkpoint (linhas de cada pagina, por snapshot do dia) ---
PRODESP_ROLEMEMBERS_STATE_DIR=/var/lib/logstash/prodesp-rolemembers
PRODESP_ROLEMEMBERS_KEEP_DAYS=3
PRODESP_ROLEMEMBERS_ROLE_STATS_SEED=/etc/logstash/pipelines/prodesp_rolemembers_role_stats.seed.json

# --- Bootstrap (ILM + template) ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# PRODESP_ROLEMEMBERS_ILM_ROLLOVER_MAX_AGE=7d
# PRODESP_ROLEMEMBERS_ILM_HOT_DAYS=7
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=CyberArk Prodesp - Membros por Role
