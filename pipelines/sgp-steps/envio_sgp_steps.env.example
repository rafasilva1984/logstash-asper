# envio_sgp_steps.env
# Credenciais e parametros do pipeline sgp-steps-daily (fonte: Alero, tenant SGP).
# Em producao: copiar para /etc/logstash/envio_sgp_steps.env,
# chmod 600, dono logstash:logstash. Preencher os <...> no servidor —
# NUNCA commitar o .env real.
#
# Todas as vars da Alero tem prefixo SGP_STEPS_: os .env de todos os
# pipelines entram no MESMO processo do Logstash (EnvironmentFile da unit),
# e ALERO_CLIENT_ID/SECRET ja sao usados pelo sws-recordings com OUTRA
# credencial — um sobrescreveria o outro.

# --- Elastic (destino) — mesmos valores dos outros .env ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=<usuario elastic>
ELASTIC_PASSWORD=<senha elastic>
SGP_STEPS_DATA_STREAM=logs-sgp.steps-default

# --- Alero (origem, tenant SGP) ---
SGP_STEPS_AUTH_URL=https://auth.alero.io/auth/realms/serviceaccounts/protocol/openid-connect/token
SGP_STEPS_BASE_URL=https://api.alero.io/v2-edge
SGP_STEPS_CLIENT_ID=<client id do ExternalServiceAccount SGP>
SGP_STEPS_CLIENT_SECRET=<client secret SGP>
SGP_STEPS_FREE_SEARCH=sgp
SGP_STEPS_PAGE_LIMIT=100
SGP_STEPS_MAX_WORKERS=10
SGP_STEPS_MAX_RETRIES=5
# TLS: o script original nao validava certificado (mantido). Para validar:
# SGP_STEPS_VERIFY_TLS=true  ou  SGP_STEPS_CA_BUNDLE=/caminho/ca.pem
SGP_STEPS_VERIFY_TLS=false

# --- Janela / checkpoint ---
# 1a execucao (sem checkpoint): ultimas LOOKBACK_HOURS.
# Depois: (checkpoint - OVERLAP) -> agora; em operacao normal = 24h + overlap.
# Execucao perdida e coberta na seguinte, ate MAX_CATCHUP_HOURS, em fatias de 24h.
SGP_STEPS_CHECKPOINT_FILE=/var/lib/logstash/sgp-steps/checkpoint
SGP_STEPS_LOOKBACK_HOURS=24
SGP_STEPS_OVERLAP_MINUTES=60
SGP_STEPS_MAX_CATCHUP_HOURS=168

# --- Agendamento (cron do input exec `schedule`) ---
# Hora LOCAL do servidor, que roda em America/Sao_Paulo (confirmado com
# timedatectl em 2026-08-24, ver envio_cyberark_detran.env.example).
SGP_STEPS_SCHEDULE=0 7 * * *

# --- Bootstrap (ILM + template) ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# SGP_STEPS_ILM_ROLLOVER_MAX_AGE=7d
# SGP_STEPS_ILM_HOT_DAYS=30
# SGP_STEPS_ILM_FROZEN_DAYS=300
# SGP_STEPS_ILM_DELETE=true
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=SGP Steps
