# envio_sws_recordings.env
# Credenciais e parametros do pipeline sws-recordings (fonte: Alero).
# Em producao: copiar para /etc/logstash/envio_sws_recordings.env,
# chmod 600, dono logstash:logstash.
#
# NOTA: credenciais aqui em texto puro (mesmo padrao ja usado no resto da
# plataforma). Rotacionar quando o projeto entrar em producao definitiva.

# --- Elastic (destino) ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=rafael.silva@asper.tec.br
ELASTIC_PASSWORD=Casa@@4321
SWS_RECORDINGS_DATA_STREAM=logs-sws.recordings-default

# --- Alero (origem) ---
ALERO_AUTH_URL=https://auth.alero.io/auth/realms/serviceaccounts/protocol/openid-connect/token
ALERO_CLIENT_ID=11ef5b3b6833603da039f387a9fa25f4.11f0ecff40717c7c80ba7534fdba8063.ExternalServiceAccount
ALERO_CLIENT_SECRET=f6b2aea28cf3718bb78f308be6cbe2cf1ebca39095850943
ALERO_BASE_URL=https://api.alero.io/v2-edge
ALERO_PAGE_LIMIT=100
ALERO_MAX_WORKERS=10
ALERO_MAX_RETRIES=5

# --- Janela / checkpoint (pipeline sws-recordings-realtime) ---
SWS_CHECKPOINT_FILE=/var/lib/logstash/sws-recordings/checkpoint
SWS_OVERLAP_MINUTES=5
SWS_BACKFILL_MINUTES=15
SWS_MAX_WINDOW_MINUTES=120
SWS_MAX_SLICES_PER_RUN=12
SWS_REALTIME_INTERVAL_SECONDS=60

# --- Reconciliacao diaria (pipeline sws-recordings-reconcile) ---
# Cobre sessoes longas que a Alero so devolve depois de FECHADAS e que por
# isso escapam da janela estreita do realtime (ver bootstrap_sws_recordings.sh
# e o comentario no topo do .conf de reconcile).
SWS_RECONCILE_LOOKBACK_HOURS=48
SWS_RECONCILE_SCHEDULE=0 4 * * *

# --- Bootstrap (ILM + template), opcional ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# SWS_ILM_HOT_MAX_AGE=15d
# SWS_ILM_HOT_MAX_SHARD_SIZE=50gb
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=SWS Recordings
