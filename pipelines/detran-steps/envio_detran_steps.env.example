# envio_detran_steps.env
# Credenciais e parametros do pipeline detran-steps-daily (fonte: Alero, tenant Detran).
# Em producao: copiar para /etc/logstash/envio_detran_steps.env,
# chmod 600, dono logstash:logstash. Preencher os <...> no servidor —
# NUNCA commitar o .env real.
#
# Todas as vars da Alero tem prefixo DETRAN_STEPS_: os .env de todos os
# pipelines entram no MESMO processo do Logstash (EnvironmentFile da unit),
# e ALERO_CLIENT_ID/SECRET ja sao usados pelo sws-recordings. Hoje o valor
# e o MESMO (mesmo service account Detran), mas nomes proprios isolam os
# pipelines: trocar a credencial de um nao afeta o outro em silencio.
# Tambem nao reusar DETRAN_* puro: e do cyberark-detran-directory.

# --- Elastic (destino) — mesmos valores dos outros .env ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=<usuario elastic>
ELASTIC_PASSWORD=<senha elastic>
DETRAN_STEPS_DATA_STREAM=logs-detran.steps-default

# --- Alero (origem, tenant Detran) ---
DETRAN_STEPS_AUTH_URL=https://auth.alero.io/auth/realms/serviceaccounts/protocol/openid-connect/token
DETRAN_STEPS_BASE_URL=https://api.alero.io/v2-edge
DETRAN_STEPS_CLIENT_ID=<client id do ExternalServiceAccount Detran, string inteira com .ExternalServiceAccount>
DETRAN_STEPS_CLIENT_SECRET=<client secret Detran>
# Vazio = todas as sessoes do tenant (default do script original).
DETRAN_STEPS_FREE_SEARCH=
DETRAN_STEPS_PAGE_LIMIT=100
DETRAN_STEPS_MAX_WORKERS=10
DETRAN_STEPS_MAX_RETRIES=5
# TLS: o script original nao validava certificado (mantido). Para validar:
# DETRAN_STEPS_VERIFY_TLS=true  ou  DETRAN_STEPS_CA_BUNDLE=/caminho/ca.pem
DETRAN_STEPS_VERIFY_TLS=false

# --- Janela / checkpoint ---
# 1a execucao (sem checkpoint): ultimas LOOKBACK_HOURS.
# Depois: (checkpoint - OVERLAP) -> agora; em operacao normal = 24h + overlap.
# Execucao perdida e coberta na seguinte, ate MAX_CATCHUP_HOURS, em fatias de 24h.
DETRAN_STEPS_CHECKPOINT_FILE=/var/lib/logstash/detran-steps/checkpoint
DETRAN_STEPS_LOOKBACK_HOURS=24
DETRAN_STEPS_OVERLAP_MINUTES=60
DETRAN_STEPS_MAX_CATCHUP_HOURS=168

# --- Agendamento (cron do input exec `schedule`) ---
# Hora LOCAL do servidor, que roda em America/Sao_Paulo (confirmado com
# timedatectl em 2026-08-24, ver envio_cyberark_detran.env.example).
# Com aspas: sem elas, `source` no bash quebra ("7: command not found");
# o systemd remove as aspas, entao funciona nos dois.
DETRAN_STEPS_SCHEDULE="0 7 * * *"

# --- Bootstrap (ILM + template) ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# DETRAN_STEPS_ILM_ROLLOVER_MAX_AGE=7d
# DETRAN_STEPS_ILM_HOT_DAYS=30
# DETRAN_STEPS_ILM_FROZEN_DAYS=300
# DETRAN_STEPS_ILM_DELETE=true
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=Detran Steps
