# envio_prodesp_applaunch.env
# Credenciais e parametros do pipeline prodesp-applaunch-realtime
# (fonte: CyberArk tenant Prodesp — AppLaunch + dados do User).
# Em producao: copiar para /etc/logstash/envio_prodesp_applaunch.env,
# chmod 600, dono logstash:logstash. Preencher os <...> no servidor —
# NUNCA commitar o .env real.
#
# Todas as vars tem prefixo PRODESP_APPLAUNCH_: os .env de todos os
# pipelines entram no MESMO processo do Logstash (EnvironmentFile da unit),
# e PRODESP_* ja e usado pelo cyberark-prodesp-directory/loginprodesp.

# --- Elastic (destino) — mesmos valores dos outros .env ---
ELASTIC_URL=https://dados-pam.es.us-east-2.aws.elastic-cloud.com:9243
ELASTIC_USER=<usuario elastic>
ELASTIC_PASSWORD=<senha elastic>
PRODESP_APPLAUNCH_DATA_STREAM=logs-cyberark.prodespapplaunch-default

# --- CyberArk tenant Prodesp (origem) ---
# Mesma credencial do loginprodesp (client elastic_bi_asper).
PRODESP_APPLAUNCH_TOKEN_URL=https://prodesp.id.cyberark.cloud/OAuth2/Token/PainelProdesp
PRODESP_APPLAUNCH_QUERY_URL=https://prodesp.id.cyberark.cloud/Redrock/query
PRODESP_APPLAUNCH_CLIENT_ID=<client id>
# Entre aspas simples: o secret tem caracteres especiais (vale pro systemd e pro `source`).
PRODESP_APPLAUNCH_CLIENT_SECRET='<client secret>'

# --- Frequencia / janela ---
# A cada 5 min; janela = (checkpoint - OVERLAP) -> agora, ~10 min em regime.
PRODESP_APPLAUNCH_INTERVAL_SECONDS=300
PRODESP_APPLAUNCH_OVERLAP_MINUTES=5
PRODESP_APPLAUNCH_CHECKPOINT_FILE=/var/lib/logstash/prodesp-applaunch/checkpoint
# 1a execucao (sem checkpoint): quanto voltar. Para backfill, aumentar
# (ex.: 720 = 30 dias) — vai em fatias de SLICE_MINUTES, MAX_SLICES_PER_RUN
# por execucao (fatia de 1h fora do prefetch custa ~1-4 min de IN na User).
PRODESP_APPLAUNCH_INITIAL_LOOKBACK_HOURS=1
PRODESP_APPLAUNCH_SLICE_MINUTES=60
PRODESP_APPLAUNCH_MAX_SLICES_PER_RUN=6

# --- Paginacao / lookup de usuarios ---
PRODESP_APPLAUNCH_PAGE_SIZE=1000
# prefetch User.LastLogin > (inicio - LOOKBACK): ~1s, cobre ~95% dos logins
PRODESP_APPLAUNCH_USER_PREFETCH_LOOKBACK_MINUTES=120
PRODESP_APPLAUNCH_USER_PREFETCH_MAX_HOURS=6
PRODESP_APPLAUNCH_USER_PREFETCH_PAGE_SIZE=10000

# --- Retry ---
PRODESP_APPLAUNCH_QUERY_TIMEOUT_SECONDS=180
PRODESP_APPLAUNCH_MAX_RETRIES=3
PRODESP_APPLAUNCH_RETRY_BACKOFF_SECONDS=5

# --- Bootstrap (ILM + template) ---
# ELASTIC_SNAPSHOT_REPOSITORY=found-snapshots
# PRODESP_APPLAUNCH_ILM_ROLLOVER_MAX_AGE=7d
# PRODESP_APPLAUNCH_ILM_HOT_DAYS=30
# KIBANA_URL=https://dados-pam.kb.us-east-2.aws.elastic-cloud.com:9243
# KIBANA_DATA_VIEW_NAME=CyberArk Prodesp - AppLaunch
